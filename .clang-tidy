# Static checks of the C++ code (technology_stack.md Section 12)
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  readability-braces-around-statements,
  readability-uppercase-literal-suffix
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/include/minidaw/.*'
